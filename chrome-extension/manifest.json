{
  "manifest_version": 3,
  "name": "Kikishima",
  "version": "1.1.5",
  "description": "Bilingual, pre-translated subtitles for online videos, powered by the Kikishima app on your Mac.",
  "key": "",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.kikishima.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "sites/youtube-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "reliability.js",
        "sites/youtube.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {},
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kikishima"
  }
}
